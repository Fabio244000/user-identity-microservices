# Solo para desarrollo local (docker-compose). En producción (AWS Lambda) no se
# usa .env: las variables de entorno de cada función se resuelven en deploy
# time desde Secrets Manager/SSM, vía referencias dinámicas en serverless.yml.
POSTGRES_USER=turfbook
POSTGRES_PASSWORD=changeme
POSTGRES_DB=user_identity
DATABASE_URL=postgresql+psycopg://turfbook:changeme@db:5432/user_identity
SECRET_KEY=changeme
SESSION_DURATION_MINUTES=30
